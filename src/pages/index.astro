---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import FilterBar from '../components/FilterBar.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import TextureCard from '../components/TextureCard.astro';
import PreviewModal from '../components/PreviewModal.astro';
import { buildClientManifest } from '../utils/textureManifest';

const textures = await buildClientManifest();
const totalCount = textures.length;
---

<Base title="Chrono India — Texture Gallery" description="Browse and download pixel art textures for Chrono India: The Shattered Timeline">
  <Header />
  <FilterBar totalCount={totalCount} />

  <GalleryGrid>
    {textures.map((tex, i) => (
      <TextureCard
        slug={tex.slug}
        fileName={tex.fileName}
        title={tex.title}
        category={tex.category}
        tags={tex.tags}
        resolution={tex.resolution}
        tileable={tex.tileable}
        palette={tex.palette}
        thumb={tex.thumb}
        src={tex.src}
        index={i}
        era={tex.era}
        prompt={tex.prompt}
      />
    ))}
  </GalleryGrid>

  <PreviewModal />

  <!-- Downloads CTA strip -->
  <section class="max-w-screen-2xl mx-auto px-4 py-8 mt-4">
    <div class="bg-surface border border-border rounded-xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h2 class="font-heading font-bold text-lg text-accent mb-1">📦 Download Texture Packs</h2>
        <p class="text-text-muted text-sm">Get all textures bundled by category as ZIP archives — ready to drop into your project.</p>
      </div>
      <a
        href="/downloads"
        class="inline-flex items-center gap-2 bg-accent hover:bg-accent-light text-bg font-heading font-semibold text-sm px-5 py-2.5 rounded-lg transition-colors whitespace-nowrap"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V4" />
        </svg>
        View All Downloads
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="text-center py-6 text-text-muted text-xs font-heading border-t border-white/5 mt-8">
    © 2026 Chrono India — Asset Pack v1.0 &nbsp;|&nbsp;
    <a href="https://github.com" class="hover:text-accent transition-colors">GitHub</a>
    &nbsp;|&nbsp;
    <a href="/downloads" class="hover:text-accent transition-colors">Downloads</a>
  </footer>
</Base>

<!-- Load Fuse.js from CDN, then init gallery scripts -->
<script is:inline>
window.__fuseLoaded = false;
(function() {
  var s = document.createElement('script');
  s.src = 'https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js';
  s.onload = function() {
    window.__fuseLoaded = true;
    if (window.__galleryFilterInit) window.__galleryFilterInit();
  };
  document.head.appendChild(s);
})();
</script>

<!-- Combined gallery client script -->
<script is:inline src="/gallery.js"></script>
