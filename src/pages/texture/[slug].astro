---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import PreviewModal from '../../components/PreviewModal.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allTextures = await getCollection('textures');
  return allTextures.map(t => ({
    params: { slug: t.slug.split('/').pop() },
    props:  { texture: t },
  }));
}

const { texture } = Astro.props;
const { title, category, tags, resolution, tileable, palette, era, prompt } = texture.data;
// Astro slug = "terrain/terrain_grass_01", we want "terrain_grass_01"
const fileName = texture.slug.includes('/') ? texture.slug.split('/').pop()! : texture.slug;
const src   = `/textures/${category}/${fileName}.png`;
const thumb = `/thumbnails/${category}/${fileName}.webp`;
---

<Base title={`${title} — Chrono India Texture Gallery`} description={`${title}, ${resolution} ${category} pixel art texture`}>
  <Header />

  <main class="max-w-4xl mx-auto px-4 py-8">
    <a href="/" class="text-accent hover:text-accent-light text-sm font-heading mb-6 inline-block transition-colors">
      ← Back to Gallery
    </a>

    <div class="flex flex-col md:flex-row gap-8">
      <!-- Image -->
      <div class="checkerboard rounded-xl flex items-center justify-center p-8 md:w-1/2">
        <img
          src={src}
          alt={`${title} — ${resolution} ${category} pixel art texture`}
          class="pixel-texture max-w-full"
          style="width: min(512px, 100%); image-rendering: pixelated;"
          onerror="this.src='/thumbnails/placeholder.webp'; this.onerror=null;"
        />
      </div>

      <!-- Metadata -->
      <div class="md:w-1/2 flex flex-col gap-5">
        <div>
          <h1 class="font-heading font-bold text-2xl text-accent mb-1">{title}</h1>
          <p class="text-text-muted text-sm font-mono">{fileName}</p>
        </div>

        <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
          <dt class="text-text-muted font-heading">Category</dt>
          <dd><CategoryBadge category={category} /></dd>

          <dt class="text-text-muted font-heading">Resolution</dt>
          <dd class="text-text-primary font-mono">{resolution}</dd>

          <dt class="text-text-muted font-heading">Era</dt>
          <dd class="text-text-primary capitalize">{era ?? 'Universal'}</dd>

          <dt class="text-text-muted font-heading">Tileable</dt>
          <dd class="text-text-primary">{tileable ? '✅ Yes' : 'No'}</dd>
        </dl>

        <!-- Tags -->
        <div>
          <p class="text-text-muted text-xs font-heading mb-2">Tags</p>
          <div class="flex flex-wrap gap-1.5">
            {tags.map(tag => <span class="tag-pill">{tag}</span>)}
          </div>
        </div>

        <!-- Palette -->
        {palette.length > 0 && (
          <div>
            <p class="text-text-muted text-xs font-heading mb-2">Palette</p>
            <div class="flex flex-wrap gap-2">
              {palette.map(c => (
                <div class="flex items-center gap-1.5">
                  <span class="color-swatch" style={`background:${c}`} />
                  <span class="text-text-muted text-xs font-mono">{c}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Actions -->
        <div class="flex flex-col gap-3 mt-auto pt-4 border-t border-white/10">
          <a
            href={src}
            download={`${fileName}.png`}
            class="flex items-center justify-center gap-2 bg-accent hover:bg-accent-light text-bg-deep font-heading font-bold px-5 py-2.5 rounded-lg transition-colors"
          >
            ⬇ Download PNG
          </a>
          {prompt && (
            <button
              id="copy-prompt-btn"
              data-prompt={prompt}
              class="flex items-center justify-center gap-2 bg-surface-2 hover:bg-surface border border-white/10 hover:border-accent/40 text-text-primary font-heading font-semibold px-5 py-2.5 rounded-lg transition-colors"
            >
              📋 Copy Generation Prompt
            </button>
          )}
        </div>
      </div>
    </div>
  </main>
</Base>

<script>
  const btn = document.getElementById('copy-prompt-btn');
  btn?.addEventListener('click', () => {
    const p = btn.dataset.prompt || '';
    navigator.clipboard.writeText(p).then(() => {
      btn.textContent = '✅ Copied!';
      setTimeout(() => { btn.textContent = '📋 Copy Generation Prompt'; }, 2000);
    });
  });
</script>
