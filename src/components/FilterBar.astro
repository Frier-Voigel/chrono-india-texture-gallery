---
interface Props {
  totalCount: number;
}
const { totalCount } = Astro.props;

const categories = [
  { id: 'all',          label: '⊞ All' },
  { id: 'terrain',      label: '🌿 Terrain' },
  { id: 'architecture', label: '🏛️ Arch' },
  { id: 'character',    label: '👘 Char' },
  { id: 'vfx',         label: '✨ VFX' },
  { id: 'props',        label: '🪣 Props' },
];
---

<div id="filter-bar" class="bg-surface-2 border-b border-white/5 px-4 py-3 sticky top-[57px] z-30">
  <div class="max-w-screen-2xl mx-auto flex flex-col sm:flex-row gap-3 items-start sm:items-center flex-wrap">

    <!-- Category tabs -->
    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by category">
      {categories.map(cat => (
        <button
          class={[
            'category-tab font-heading font-semibold text-xs sm:text-sm px-3 py-1 rounded-full border transition-colors',
            cat.id === 'all'
              ? 'text-accent border-accent/60 bg-accent/10'
              : 'text-text-muted border-white/10 hover:text-accent hover:border-accent/40',
          ].join(' ')}
          data-category={cat.id}
          aria-pressed={cat.id === 'all' ? 'true' : 'false'}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Search input -->
    <div class="relative flex-1 min-w-[160px] max-w-xs">
      <label for="search-input" class="sr-only">Search textures</label>
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-muted text-sm pointer-events-none" aria-hidden="true">🔍</span>
      <input
        id="search-input"
        type="search"
        placeholder="Search textures…"
        aria-label="Search textures by name or tag"
        autocomplete="off"
        class="w-full bg-surface border border-white/10 rounded-full pl-8 pr-4 py-1.5 text-sm text-text-primary placeholder:text-text-muted focus:border-accent focus:outline-none transition-colors"
      />
    </div>

    <!-- Tileable toggle -->
    <label class="flex items-center gap-2 cursor-pointer select-none shrink-0" title="Show only tileable textures">
      <input
        id="tileable-toggle"
        type="checkbox"
        class="sr-only peer"
        aria-label="Show tileable textures only"
      />
      <!-- Custom toggle track -->
      <span class="relative inline-flex w-9 h-5 rounded-full border border-white/20 bg-surface transition-colors peer-checked:bg-tileable/50 peer-checked:border-tileable/70 peer-focus-visible:ring-2 peer-focus-visible:ring-accent" aria-hidden="true">
        <span class="absolute top-0.5 left-0.5 w-4 h-4 rounded-full bg-text-muted transition-all duration-150 peer-checked:translate-x-4 peer-checked:bg-white"></span>
      </span>
      <span class="text-sm text-text-muted font-heading font-semibold whitespace-nowrap">✦ Tileable</span>
    </label>

    <!-- ERA filter (bonus) -->
    <select
      id="era-filter"
      aria-label="Filter by historical era"
      class="bg-surface border border-white/10 rounded-full px-3 py-1.5 text-xs text-text-muted font-heading focus:border-accent focus:outline-none transition-colors cursor-pointer"
    >
      <option value="">All Eras</option>
      <option value="vedic">🌄 Vedic</option>
      <option value="mughal">🕌 Mughal</option>
      <option value="colonial">🏛️ Colonial</option>
      <option value="modern">🏙️ Modern</option>
      <option value="future">🚀 Future</option>
      <option value="universal">∞ Universal</option>
    </select>

  </div>

  <!-- Result count + active filters summary -->
  <div class="max-w-screen-2xl mx-auto mt-2 flex items-center gap-3 flex-wrap">
    <span id="result-count" class="text-xs text-text-muted font-heading" aria-live="polite" aria-atomic="true">
      Showing {totalCount} of {totalCount} textures
    </span>
    <button
      id="clear-filters-btn"
      class="hidden text-xs text-accent hover:text-accent-light font-heading underline transition-colors"
      aria-label="Clear all active filters"
    >
      × Clear filters
    </button>
  </div>
</div>
